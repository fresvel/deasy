{
  "name": "da",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test:unit": "node --test \"config/*.test.js\" \"database/**/*.test.js\" \"services/**/*.test.js\" \"utils/**/*.test.js\" \"middlewares/**/*.test.js\" \"controllers/**/*.test.js\" \"errors/**/*.test.js\"",
    "_comment:coverage": "test:unit:coverage corre desde la raiz del repo (cd ..) para que las rutas SF del lcov salgan como backend/... y SonarQube las resuelva. Si añades una carpeta a los globs de test:unit, añadela TAMBIEN aqui.",
    "test:unit:coverage": "cd .. && mkdir -p backend/coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=backend/coverage/lcov.info \"backend/config/*.test.js\" \"backend/database/**/*.test.js\" \"backend/services/**/*.test.js\" \"backend/utils/**/*.test.js\" \"backend/middlewares/**/*.test.js\" \"backend/controllers/**/*.test.js\" \"backend/errors/**/*.test.js\"",
    "test:char": "node --test --test-concurrency=1 tests/characterization/flows/*.test.mjs",
    "test:char:bootstrap": "node tests/characterization/setup/bootstrap_system.mjs",
    "test:char:seed": "node tests/characterization/setup/seed_execution.mjs",
    "test:char:fixture": "node scripts/reset.mjs db --yes && npm run test:char:bootstrap && npm run test:char:seed",
    "test:char:run": "npm run test:char:fixture && npm run test:char",
    "test:char:capture": "npm run test:char:fixture && SNAPSHOT_MODE=update npm run test:char",
    "check:imports": "node scripts/check_missing_imports.mjs",
    "recover:admin": "node scripts/bootstrap_admin_recovery.mjs",
    "seed:dev": "node scripts/seed_dev_rich.mjs",
    "seed:certs": "node scripts/generate_demo_certificates.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "fs-extra": "^11.3.4",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.22.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "whatsapp-web.js": "^1.34.6"
  }
}
