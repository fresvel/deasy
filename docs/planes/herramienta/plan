    a = ap.parse_args()
    if a.cmd not in ("init", "actualizar"):
        delegar_a_la_copia(a)
    a.fn(a)


SIN_COPIA_AVISADO = "PLAN_SIN_DELEGAR"


def delegar_a_la_copia(a):
    """Dentro de un proyecto corre SU copia de la herramienta, no la del skill.
    Así el proyecto se comprueba con la versión que fijó, igual aquí que en la
    integración continua, y un cambio en el skill no lo pone en rojo sin que
    nadie lo pida. Si la copia es más vieja, se dice en una línea y se sigue."""
    if os.environ.get(SIN_COPIA_AVISADO):
        return
    raiz = buscar_raiz()
    if raiz is None:
        return
    copia = raiz / HERRAMIENTA / "plan"
    yo = Path(__file__).resolve()
    if not copia.is_file():
        if yo.parent.name != HERRAMIENTA:
            print(f"plan: este proyecto no lleva copia de la herramienta "
                  f"({HERRAMIENTA}/): corro con la del skill (v{VERSION}). "
                  "Fíjala con `plan actualizar --aplicar`.", file=sys.stderr)
        return
    if copia.resolve() == yo:
        return
    v = version_de(copia)
    if v == VERSION and not misma_herramienta(copia.parent):
        print(f"plan: la copia de este proyecto es v{v} como el skill, pero difiere "
              "(correcciones sin cambio de versión). Corro con la del proyecto; "
              "`plan actualizar` la pone al día.", file=sys.stderr)
    if v < VERSION:
        print(f"plan: este proyecto lleva la herramienta v{v}; el skill está en v{VERSION}. "
              "Corro con la del proyecto. Para subirla: `plan actualizar`.", file=sys.stderr)
    elif v > VERSION:
        print(f"plan: este proyecto lleva la herramienta v{v}, MÁS NUEVA que el skill (v{VERSION}). "
              "Corro con la del proyecto.", file=sys.stderr)
    os.environ[SIN_COPIA_AVISADO] = "1"
    os.environ["PLAN_RAIZ"] = str(raiz)      # la copia no vuelve a buscar: ya está decidido
    os.execv(sys.executable, [sys.executable, str(copia), *sys.argv[1:]])


def misma_herramienta(dir_copia):
    """¿La copia es byte a byte la del skill (programa y vocabulario)?"""
    try:
        return ((dir_copia / "plan").read_bytes() == Path(__file__).resolve().read_bytes()
                and (dir_copia / "vocabulario.yaml").read_bytes() == ruta_vocabulario().read_bytes())
    except OSError:
        return False


def cmd_actualizar(a):
    import subprocess, tempfile
    raiz = raiz_o_muere()
    if Path(__file__).resolve().parent.name == HERRAMIENTA:
        muere("`actualizar` se corre con el `plan` del skill, no con la copia del proyecto")
    copia = raiz / HERRAMIENTA / "plan"
    v = version_de(copia) if copia.is_file() else None
    if v is not None and misma_herramienta(raiz / HERRAMIENTA):
        print(f"✅ el proyecto ya lleva la herramienta v{VERSION}, idéntica al skill")
        return
    de = f"v{v}" if v is not None else "ninguna copia"
    flecha = f"{de} → v{VERSION}" if v != VERSION else f"v{VERSION} con correcciones"
    print(f"── herramienta: {flecha}")
    # Antes de tocar nada: qué diría la puerta NUEVA sobre este plan, tal como está.
    with tempfile.TemporaryDirectory() as tmp:
        t = Path(tmp)
        import shutil
        shutil.copyfile(Path(__file__).resolve(), t / "plan")
        shutil.copyfile(ruta_vocabulario(), t / "vocabulario.yaml")
        env = {**os.environ, "PLAN_RAIZ": str(raiz), SIN_COPIA_AVISADO: "1"}
        print(f"   con la v{VERSION}, `plan verificar` diría:")
        print()
        sys.stdout.flush()      # el hijo escribe directo; sin esto su salida sale antes que esta cabecera
        r = subprocess.run([sys.executable, str(t / "plan"), "verificar"], env=env)
    print()
    if not a.aplicar:
        print("(vista previa — nada cambiado. Repite con --aplicar para fijar la "
              f"v{VERSION} en {HERRAMIENTA}/)")
        return
    copiar_herramienta(raiz)
    print(f"✅ herramienta v{VERSION} fijada en {raiz / HERRAMIENTA}"
          + ("" if r.returncode == 0 else f"  ⚠️ la puerta sale con código {r.returncode}: hay fallos que atender"))


if __name__ == "__main__":
    main()
