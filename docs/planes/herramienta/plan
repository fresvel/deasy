    guardar_config(raiz, cfg)
    print(f"✅ {n} heredado(s) fechados el {a.fecha}; los que ya tenían fecha no se tocan")


RE_FILA = re.compile(
    r"^\|\s*\**`?([A-Za-z][\w.\-]*)`?\**\s*\|(.+?)\|\s*(⬜|🟡|⛔|✅|🚫|∅|➡️)\s*\|(.*)$")
EMOJI_A_ESTADO = {v: k for k, v in ESTADOS.items()}


def cmd_migrar(a):
    p = un_proyecto(raiz_o_muere(), a.proyecto)
    src = Path(a.ruta)
    if not src.is_file():
        muere(f"no existe {src}")
    if a.frente not in p.frentes:
        muere(f"crea antes el frente {a.frente} (`plan frente nuevo`)")
    fases = p.fases_de(a.frente)
    if not fases:
        muere(f"el frente {a.frente} no tiene fases; créalas antes")
    destino_fase = a.fase or sorted(fases, key=clave_orden)[0]
    if destino_fase not in fases:
        muere(f"no existe la fase {destino_fase}")

    filas = []
    for linea in src.read_text().splitlines():
        m = RE_FILA.match(linea.strip())
        if m:
            viejo, entrega, emoji, resto = m.groups()
            campos = [c.strip() for c in resto.split("|")]
            filas.append({
                "viejo": viejo,
                "entrega": entrega.replace("**", "").strip().strip("`").strip(),
                "estado": EMOJI_A_ESTADO.get(emoji, "pendiente"),
                "evidencia": campos[0] if campos else "",
                "fecha": next((c for c in campos if RE_FECHA.match(c)), ""),
            })
    if not filas:
        muere("no encontré filas de control (| ID | qué entrega | estado | evidencia | fecha |)")

    n = len(p.tareas_de_fase(destino_fase))
    print(f"{len(filas)} fila(s) de {src.name} → {destino_fase}")
    plan = []
    for i, f in enumerate(filas, start=n + 1):
        nid = f"{destino_fase}.T{i}"
        plan.append((nid, f))
        print(f"  {nid}  {glifo(f['estado'])}  [{f['viejo']}]  {f['entrega'][:70]}")
    if not a.aplicar:
        print("\n(vista previa — repite con --aplicar)")
        return
    for nid, f in plan:
        meta = {"id": nid, "tipo": a.tipo, "estado": f["estado"],
                "entrega": f["entrega"], "evidencia": f["evidencia"],
                "fecha": f["fecha"], "revision_pendiente": True}
        cuerpo = (f"Migrada de `{src.name}`, donde era **{f['viejo']}**.\n\n"
                  "⚠️ Pendiente de revisión: comprueba que «Qué entrega» sea falsable, "
                  "que el tipo sea el correcto y que lleve `realiza`/`dijo` si toca.\n")
        escribir_md(p.dir / "tareas" / f"{nid}.md", meta, cuerpo)
    print(f"\n✅ {len(plan)} tarea(s) creadas, marcadas `revision_pendiente`")


