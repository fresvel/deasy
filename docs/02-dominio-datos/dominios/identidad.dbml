// ============================================================================
// ARTEFACTO GENERADO — NO EDITAR A MANO.
//
// Lo produce `bash scripts/docs/gen-dbml.sh` levantando un PostgreSQL desechable,
// aplicando `backend/database/postgres_schema.sql` e introspeccionando la base.
// Cualquier cambio hecho aquí se pierde en la siguiente regeneración, y la puerta
// de CI (.github/workflows/docs-dbml.yml) lo detecta.
//
// ¿Quieres explicar qué SIGNIFICA una tabla o una columna?
//   -> docs/02-dominio-datos/anotaciones.json  (eso sí se escribe a mano)
// Dominio: Identidad, personas y RBAC. Reparto: scripts/docs/dominios.json
// ============================================================================

Project identidad {
  database_type: 'PostgreSQL'
  Note: '''Identidad, personas y RBAC — Quién es cada quien y qué puede hacer. `persons` es la identidad única del sistema; el expediente (dossier) cuelga de ella.'''
}

Table "actions" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "code" varchar(40) [unique, not null]
  "name" varchar(120) [not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "cargo_role_map" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "role_id" int4 [not null]
  "cargo_id" int4 [not null]

  Indexes {
    (cargo_id, role_id) [type: btree, unique, name: "uq_cargo_role_map"]
  }
}

Table "cargos" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "code" varchar(120) [unique, not null]
  "name" varchar(120) [unique, not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "dossier_items" [headercolor: #1F5FC7] {
  "id" int8 [pk, not null, increment]
  "dossier_id" int8 [not null]
  "section" varchar(20) [not null]
  "data" jsonb [not null, default: `{}`]
  "url_documento" text [not null, default: '']
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (dossier_id, section, id) [type: btree, name: "idx_dossier_items"]
  }
}

Table "dossiers" [headercolor: #1F5FC7] {
  "id" int8 [pk, not null, increment]
  "person_id" int4 [unique, not null]
  "cedula" varchar(20)
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    cedula [type: btree, name: "idx_dossiers_cedula"]
  }

  Note: '''El expediente de una persona. Sustituye a la colección de MongoDB retirada en la migración a PostgreSQL; enlaza por cédula.'''
}

Table "email_verification_codes" [headercolor: #1F5FC7] {
  "id" int8 [pk, not null, increment]
  "person_id" int4 [not null]
  "code_hash" varchar(255) [not null]
  "expires_at" timestamp [not null]
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]

  Indexes {
    expires_at [type: btree, name: "idx_evc_expires_at"]
    person_id [type: btree, name: "idx_evc_person_id"]
  }
}

Table "password_reset_codes" [headercolor: #1F5FC7] {
  "id" int8 [pk, not null, increment]
  "person_id" int4 [not null]
  "code_hash" varchar(255) [not null]
  "expires_at" timestamp [not null]
  "used" int2 [default: 0]
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]

  Indexes {
    expires_at [type: btree, name: "idx_prc_expires_at"]
    person_id [type: btree, name: "idx_prc_person_id"]
  }
}

Table "permissions" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "resource_id" int4 [not null]
  "action_id" int4 [not null]
  "code" varchar(120) [unique, not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (resource_id, action_id) [type: btree, unique, name: "uq_permissions_resource_action"]
    action_id [type: btree, name: "idx_permissions_action"]
    resource_id [type: btree, name: "idx_permissions_resource"]
  }
}

Table "person_certificates" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "person_id" int4 [not null]
  "label" varchar(180) [not null]
  "original_filename" varchar(255) [not null]
  "bucket" varchar(120) [not null]
  "object_name" varchar(500) [not null]
  "is_default" int2 [not null, default: 0]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (person_id, is_default) [type: btree, name: "idx_person_certificates_default"]
    person_id [type: btree, name: "idx_person_certificates_person"]
  }
}

Table "persons" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "cedula" varchar(20) [unique]
  "first_name" varchar(120) [not null]
  "last_name" varchar(120) [not null]
  "email" varchar(180) [unique]
  "whatsapp" varchar(30)
  "direccion" varchar(255)
  "pais" varchar(80)
  "pais_residencia" varchar(80)
  "provincia_residencia" varchar(120)
  "ciudad_residencia" varchar(120)
  "calle_primaria" varchar(180)
  "calle_secundaria" varchar(180)
  "codigo_postal" varchar(30)
  "password_hash" varchar(255) [not null]
  "status" text [check: `status = ANY (ARRAY['Inactivo'::text, 'Activo'::text, 'Verificado'::text, 'Reportado'::text])`, default: 'Inactivo']
  "verify_email" int2 [default: 0]
  "verify_whatsapp" int2 [default: 0]
  "photo_url" text
  "is_active" int2 [not null, default: 1]
  "token" varchar(10) [unique, not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "resources" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "code" varchar(80) [unique, not null]
  "name" varchar(120) [not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "role_assignment_relation_types" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "relation_type_id" int4 [not null]
  "role_assignment_id" int4 [not null]

  Indexes {
    (role_assignment_id, relation_type_id) [type: btree, name: "idx_role_assignment_relation_types"]
  }
}

Table "role_assignments" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "role_id" int4 [not null]
  "unit_id" int4 [not null]
  "derived_from_assignment_id" int4
  "source" text [not null, check: `source = ANY (ARRAY['manual'::text, 'derived'::text])`, default: 'manual']
  "person_id" int4 [not null]
  "max_depth" int4 [not null]
  "start_date" date [not null]
  "end_date" date
  "is_current" int2 [not null, default: 1]
  "current_flag" int2 [note: "columna generada (STORED)"]
  "assigned_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "revoked_at" timestamp
  "revoked_reason" varchar(255)

  Indexes {
    (person_id, role_id, unit_id, source, current_flag) [type: btree, unique, name: "uq_role_assignment_current"]
    person_id [type: btree, name: "idx_role_assignments_person"]
    unit_id [type: btree, name: "idx_role_assignments_unit"]
  }
}

Table "role_permissions" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "role_id" int4 [not null]
  "permission_id" int4 [not null]

  Indexes {
    (role_id, permission_id) [type: btree, unique, name: "uq_role_permissions"]
  }
}

Table "roles" [headercolor: #1F5FC7] {
  "id" int4 [pk, not null, increment]
  "name" varchar(120) [unique, not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
}

Ref "fk_cargo_role_map_cargo":"cargos"."id" <? "cargo_role_map"."cargo_id"
Ref "fk_cargo_role_map_role":"roles"."id" <? "cargo_role_map"."role_id"
Ref "fk_dossier_items_dossier":"dossiers"."id" <? "dossier_items"."dossier_id" [delete: cascade]
Ref "fk_email_verification_person":"persons"."id" <? "email_verification_codes"."person_id" [delete: cascade]
Ref "fk_password_reset_person":"persons"."id" <? "password_reset_codes"."person_id" [delete: cascade]
Ref "fk_permissions_action":"actions"."id" <? "permissions"."action_id"
Ref "fk_permissions_resource":"resources"."id" <? "permissions"."resource_id"
Ref "fk_person_certificates_person":"persons"."id" <? "person_certificates"."person_id" [delete: cascade]
Ref "fk_role_assignment_relation_types_role_assignment":"role_assignments"."id" <? "role_assignment_relation_types"."role_assignment_id"
Ref "fk_role_assignments_person":"persons"."id" <? "role_assignments"."person_id"
Ref "fk_role_assignments_role":"roles"."id" <? "role_assignments"."role_id"
Ref "fk_role_permissions_permission":"permissions"."id" <? "role_permissions"."permission_id"
Ref "fk_role_permissions_role":"roles"."id" <? "role_permissions"."role_id"

