// ============================================================================
// ARTEFACTO GENERADO — NO EDITAR A MANO.
//
// Lo produce `bash scripts/docs/gen-dbml.sh` levantando un PostgreSQL desechable,
// aplicando `backend/database/postgres_schema.sql` e introspeccionando la base.
// Cualquier cambio hecho aquí se pierde en la siguiente regeneración, y la puerta
// de CI (.github/workflows/docs-dbml.yml) lo detecta.
//
// ¿Quieres explicar qué SIGNIFICA una tabla o una columna?
//   -> docs/02-dominio-datos/anotaciones.json  (eso sí se escribe a mano)
// Dominio: Identidad, personas y RBAC. Reparto: scripts/docs/dominios.json
// ============================================================================

Project identidad {
  database_type: 'PostgreSQL'
  Note: '''Identidad, personas y RBAC — Quién es cada quien y qué puede hacer. `persons` es la identidad única del sistema; el expediente (dossier) cuelga de ella.'''
}

Table "actions" {
  "id" int4 [pk, not null, increment]
  "code" varchar(40) [unique, not null]
  "name" varchar(120) [not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "canales_bitacora" {
  "id" int8 [pk, not null, increment]
  "canal" varchar(40) [not null]
  "salud" varchar(20) [not null]
  "evidencia" varchar(20)
  "detalle" text
  "desde" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "hasta" timestamp
  "avisado_at" timestamp

  Indexes {
    (canal, desde) [type: btree, name: "idx_canales_bitacora"]
  }

  Note: '''El historial de como han estado los canales de mensajeria. UNA FILA POR CAMBIO de estado, no por comprobacion: se mira cada minuto y anotar cada vuelta serian 1 440 filas al dia por canal para decir «sigue bien». `hasta` nulo significa «sigue asi ahora mismo». El canal `servicio` es el propio microservicio: si NO CONTESTA, eso es un estado y hay que poder contarlo. Contesta la pregunta que nadie pudo responder el 2026-08-31: ¿cuanto llevaba roto?'''
}

Table "canales_mensajeria" {
  "id" int4 [pk, not null, increment]
  "code" varchar(40) [unique, not null]
  "name" varchar(80) [not null]
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "cargo_role_map" {
  "id" int4 [pk, not null, increment]
  "role_id" int4 [not null]
  "cargo_id" int4 [not null]

  Indexes {
    (cargo_id, role_id) [type: btree, unique, name: "uq_cargo_role_map"]
  }
}

Table "cargos" {
  "id" int4 [pk, not null, increment]
  "code" varchar(120) [unique, not null]
  "name" varchar(120) [unique, not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "consentimientos" {
  "id" int8 [pk, not null, increment]
  "person_id" int4 [not null]
  "documento_id" int4 [not null]
  "aceptado_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "ip" varchar(60)
  "revocado_at" timestamp

  Indexes {
    (person_id, documento_id) [type: btree, unique, name: "uq_consentimiento"]
    person_id [type: btree, name: "idx_consentimiento_persona"]
  }

  Note: '''La prueba de que alguien acepto: quien, a que documento, cuando y desde donde. Hasta el 2026-09-02 NO SE GUARDABA NADA -- la casilla se validaba en el navegador y moria ahi--, y el Art. 5 del Reglamento de la LOPDP exige que el consentimiento «debera ser DEMOSTRADO por el responsable que lo obtiene». UNA FILA POR FINALIDAD, porque el Art. 8 pide que sea especifico y que, con varias finalidades, CONSTE para todas ellas. Y SIN clave ajena a `persons` a proposito: el Art. 18.4 dice que la eliminacion no procede cuando los datos son necesarios «para la formulacion, el ejercicio o la defensa de reclamaciones», asi que la fila sobrevive a la persona.'''
}

Table "direcciones" {
  "id" int4 [pk, not null, increment]
  "person_id" int4 [not null]
  "tipo" text [not null, check: `tipo = ANY (ARRAY['residencia'::text, 'trabajo'::text])`]
  "pais_id" int4
  "provincia_id" int4
  "canton_id" int4
  "calle_primaria" varchar(180)
  "calle_secundaria" varchar(180)
  "referencia" varchar(255)
  "latitud" numeric(9,6)
  "longitud" numeric(9,6)
  "principal" int2 [not null, default: 0]
  "principal_flag" int2 [note: "columna generada (STORED)"]
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (person_id, tipo, principal_flag) [type: btree, unique, name: "uq_direcciones_principal"]
    person_id [type: btree, name: "idx_direcciones_person"]
  }
}

Table "documentos_identidad" {
  "id" int4 [pk, not null, increment]
  "person_id" int4 [not null]
  "tipo" text [not null, check: `tipo = ANY (ARRAY['documento_nacional'::text, 'documento_extranjero'::text, 'pasaporte'::text])`]
  "pais_id" int4 [not null]
  "numero" varchar(40) [not null]
  "verificado" int2 [not null, default: 0]
  "verificado_at" timestamp
  "emitido_el" date
  "expira_el" date
  "escaneo_ref" varchar(255)
  "escaneo_subido_at" timestamp
  "principal" int2 [not null, default: 0]
  "principal_flag" int2 [note: "columna generada (STORED)"]
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (tipo, pais_id, numero) [type: btree, unique, name: "uq_documentos_numero"]
    (person_id, principal_flag) [type: btree, unique, name: "uq_documentos_principal"]
    numero [type: btree, name: "idx_documentos_numero"]
    person_id [type: btree, name: "idx_documentos_person"]
  }
}

Table "documentos_legales" {
  "id" int4 [pk, not null, increment]
  "clase" varchar(60) [unique, not null]
  "version" varchar(40) [not null]
  "contenido_hash" bpchar(64)
  "bucket" varchar(120)
  "object_key" varchar(500)
  "object_version_id" varchar(120)
  "estado" text [not null, check: `estado = ANY (ARRAY['draft'::text, 'published'::text, 'retired'::text])`, default: 'draft']
  "publicado_at" timestamp
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (clase, version) [type: btree, unique, name: "uq_documento_legal"]
  }

  Note: '''Los textos legales que una persona acepta, VERSION A VERSION. Sigue el patron de `template_artifacts`: version, estado de ciclo de vida y huella del contenido. El BORRADOR vive en la columna `texto` de esta tabla y el PUBLICADO en el archivo inmutable, porque una errata publicada en un almacen con bloqueo de objetos quedaria diez años sin poder quitarse. Publicar es lo que mueve el texto de un sitio al otro, y es irreversible. `retired` NO es borrar: hay gente cuya prueba de consentimiento apunta a esa version.'''
}

Table "dossier_items" {
  "id" int8 [pk, not null, increment]
  "dossier_id" int8 [not null]
  "section" varchar(20) [not null]
  "data" jsonb [not null, default: `{}`]
  "url_documento" text [not null, default: '']
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (dossier_id, section, id) [type: btree, name: "idx_dossier_items"]
  }
}

Table "dossiers" {
  "id" int8 [pk, not null, increment]
  "person_id" int4 [unique, not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Note: '''El expediente de una persona. Sustituye a la colección de MongoDB retirada en la migración a PostgreSQL; enlaza por cédula.'''
}

Table "email_verification_codes" {
  "id" int8 [pk, not null, increment]
  "email_id" int4 [not null]
  "code_hash" varchar(255) [not null]
  "expires_at" timestamp [not null]
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]

  Indexes {
    email_id [type: btree, name: "idx_evc_email_id"]
    expires_at [type: btree, name: "idx_evc_expires_at"]
  }
}

Table "emails" {
  "id" int4 [pk, not null, increment]
  "person_id" int4 [not null]
  "tipo" text [not null, check: `tipo = ANY (ARRAY['personal'::text, 'institucional'::text])`]
  "direccion" varchar(180) [unique, not null]
  "verificado" int2 [not null, default: 0]
  "verificado_at" timestamp
  "principal" int2 [not null, default: 0]
  "principal_flag" int2 [note: "columna generada (STORED)"]
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (person_id, principal_flag) [type: btree, unique, name: "uq_emails_principal"]
    person_id [type: btree, name: "idx_emails_person"]
  }
}

Table "intentos_limitados" {
  "id" int8 [pk, not null, increment]
  "accion" varchar(60) [not null]
  "sujeto" varchar(160) [not null]
  "ocurrido_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (accion, sujeto, ocurrido_at) [type: btree, name: "idx_intentos_ventana"]
  }

  Note: '''Lo que se ha intentado y CUENTA para un limite. No es una bitacora general: aqui solo entra lo que se frena, porque registrar cada peticion doblaria las escrituras del sistema para no usarlas. Vive en la base y no en memoria porque un contador en memoria dejaria de proteger en cuanto hubiera dos instancias del backend. `sujeto` es un TEXTO y no una clave ajena a proposito: lo que se cuenta cambia con la accion --una IP, un correo+ip, un person_id-- y hay acciones anonimas en las que no existe ninguna fila a la que apuntar.'''
}

Table "password_reset_codes" {
  "id" int8 [pk, not null, increment]
  "person_id" int4 [not null]
  "code_hash" varchar(255) [not null]
  "expires_at" timestamp [not null]
  "used" int2 [default: 0]
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]

  Indexes {
    expires_at [type: btree, name: "idx_prc_expires_at"]
    person_id [type: btree, name: "idx_prc_person_id"]
  }
}

Table "permissions" {
  "id" int4 [pk, not null, increment]
  "resource_id" int4 [not null]
  "action_id" int4 [not null]
  "code" varchar(120) [unique, not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (resource_id, action_id) [type: btree, unique, name: "uq_permissions_resource_action"]
    action_id [type: btree, name: "idx_permissions_action"]
    resource_id [type: btree, name: "idx_permissions_resource"]
  }
}

Table "person_certificates" {
  "id" int4 [pk, not null, increment]
  "person_id" int4 [not null]
  "label" varchar(180) [not null]
  "original_filename" varchar(255) [not null]
  "bucket" varchar(120) [not null]
  "object_name" varchar(500) [not null]
  "is_default" int2 [not null, default: 0]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (person_id, is_default) [type: btree, name: "idx_person_certificates_default"]
    person_id [type: btree, name: "idx_person_certificates_person"]
  }
}

Table "persons" {
  "id" int4 [pk, not null, increment]
  "first_name" varchar(120) [not null]
  "last_name" varchar(120) [not null]
  "nacionalidad_pais_id" int4
  "password_hash" varchar(255) [not null]
  "status" text [check: `status = ANY (ARRAY['Inactivo'::text, 'Activo'::text, 'Verificado'::text, 'Reportado'::text])`, default: 'Inactivo']
  "photo_url" text
  "is_active" int2 [not null, default: 1]
  "token" varchar(10) [unique, not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    nacionalidad_pais_id [type: btree, name: "idx_persons_nacionalidad"]
  }
}

Table "resources" {
  "id" int4 [pk, not null, increment]
  "code" varchar(80) [unique, not null]
  "name" varchar(120) [not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "role_assignment_relation_types" {
  "id" int4 [pk, not null, increment]
  "relation_type_id" int4 [not null]
  "role_assignment_id" int4 [not null]

  Indexes {
    (role_assignment_id, relation_type_id) [type: btree, name: "idx_role_assignment_relation_types"]
  }
}

Table "role_assignments" {
  "id" int4 [pk, not null, increment]
  "role_id" int4 [not null]
  "unit_id" int4 [not null]
  "derived_from_assignment_id" int4
  "source" text [not null, check: `source = ANY (ARRAY['manual'::text, 'derived'::text])`, default: 'manual']
  "person_id" int4 [not null]
  "max_depth" int4 [not null]
  "start_date" date [not null]
  "end_date" date
  "is_current" int2 [not null, default: 1]
  "current_flag" int2 [note: "columna generada (STORED)"]
  "assigned_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "revoked_at" timestamp
  "revoked_reason" varchar(255)

  Indexes {
    (person_id, role_id, unit_id, source, current_flag) [type: btree, unique, name: "uq_role_assignment_current"]
    person_id [type: btree, name: "idx_role_assignments_person"]
    unit_id [type: btree, name: "idx_role_assignments_unit"]
  }
}

Table "role_permissions" {
  "id" int4 [pk, not null, increment]
  "role_id" int4 [not null]
  "permission_id" int4 [not null]

  Indexes {
    (role_id, permission_id) [type: btree, unique, name: "uq_role_permissions"]
  }
}

Table "roles" {
  "id" int4 [pk, not null, increment]
  "name" varchar(120) [unique, not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
}

Table "telefono_canales" {
  "id" int4 [pk, not null, increment]
  "telefono_id" int4 [not null]
  "canal_id" int4 [not null]
  "verificado" int2 [not null, default: 0]
  "verificado_at" timestamp
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (telefono_id, canal_id) [type: btree, unique, name: "uq_telefono_canales"]
  }
}

Table "telefono_verification_keys" {
  "id" int8 [pk, not null, increment]
  "telefono_id" int4 [not null]
  "llave_hash" bpchar(64) [unique, not null]
  "expira_at" timestamp [not null]
  "consumida_at" timestamp [note: '''Se marca en vez de borrar la fila, para distinguir «esa llave no existe» de «esa llave ya se usó». Son dos mensajes distintos: sólo el segundo le dice al usuario que pida otra sin cambiar nada de lo que hizo.''']
  "canal_id" int4 [note: '''Por dónde se consumió. Es clave ajena a `canales_mensajeria` y no un CHECK: verificar por Telegram demuestra que el número es suyo Y que tiene Telegram, que es el hecho que `telefono_canales` guarda. Con un vocabulario aparte habría dos listas para un solo suceso.''']
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    expira_at [type: btree, name: "idx_tvk_expira"]
    telefono_id [type: btree, name: "idx_tvk_telefono"]
  }

  Note: '''La llave con la que alguien demuestra que un número de teléfono es suyo. La persona la lleva a un canal —un QR de Telegram, un enlace de WhatsApp— y el microservicio `channels` la trae de vuelta. Se cifra con SHA-256 y no con bcrypt porque hay que BUSCAR por ella: el servicio sólo tiene la llave, y encontrar de qué teléfono es *es* la operación.'''
}

Table "telefonos" {
  "id" int4 [pk, not null, increment]
  "person_id" int4 [not null]
  "tipo" text [not null, check: `tipo = ANY (ARRAY['personal'::text, 'trabajo'::text])`]
  "pais_id" int4
  "numero" varchar(30) [not null]
  "principal" int2 [not null, default: 0]
  "principal_flag" int2 [note: "columna generada (STORED)"]
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (pais_id, numero) [type: btree, unique, name: "uq_telefonos_numero"]
    (person_id, tipo, principal_flag) [type: btree, unique, name: "uq_telefonos_principal"]
    person_id [type: btree, name: "idx_telefonos_person"]
  }
}

Ref "fk_cargo_role_map_cargo":"cargos"."id" <? "cargo_role_map"."cargo_id"
Ref "fk_cargo_role_map_role":"roles"."id" <? "cargo_role_map"."role_id"
Ref "fk_consentimiento_documento":"documentos_legales"."id" <? "consentimientos"."documento_id"
Ref "fk_direcciones_person":"persons"."id" <? "direcciones"."person_id" [delete: cascade]
Ref "fk_documentos_person":"persons"."id" <? "documentos_identidad"."person_id" [delete: cascade]
Ref "fk_dossier_items_dossier":"dossiers"."id" <? "dossier_items"."dossier_id" [delete: cascade]
Ref "fk_dossiers_person":"persons"."id" <? "dossiers"."person_id" [delete: cascade]
Ref "fk_email_verification_codes_email":"emails"."id" <? "email_verification_codes"."email_id" [delete: cascade]
Ref "fk_emails_person":"persons"."id" <? "emails"."person_id" [delete: cascade]
Ref "fk_password_reset_person":"persons"."id" <? "password_reset_codes"."person_id" [delete: cascade]
Ref "fk_permissions_action":"actions"."id" <? "permissions"."action_id"
Ref "fk_permissions_resource":"resources"."id" <? "permissions"."resource_id"
Ref "fk_person_certificates_person":"persons"."id" <? "person_certificates"."person_id" [delete: cascade]
Ref "fk_role_assignment_relation_types_role_assignment":"role_assignments"."id" <? "role_assignment_relation_types"."role_assignment_id"
Ref "fk_role_assignments_person":"persons"."id" <? "role_assignments"."person_id"
Ref "fk_role_assignments_role":"roles"."id" <? "role_assignments"."role_id"
Ref "fk_role_permissions_permission":"permissions"."id" <? "role_permissions"."permission_id"
Ref "fk_role_permissions_role":"roles"."id" <? "role_permissions"."role_id"
Ref "fk_telefono_canales_canal":"canales_mensajeria"."id" <? "telefono_canales"."canal_id"
Ref "fk_telefono_canales_telefono":"telefonos"."id" <? "telefono_canales"."telefono_id" [delete: cascade]
Ref "fk_tvk_canal":"canales_mensajeria"."id" ?<? "telefono_verification_keys"."canal_id"
Ref "fk_tvk_telefono":"telefonos"."id" <? "telefono_verification_keys"."telefono_id" [delete: cascade]
Ref "fk_telefonos_person":"persons"."id" <? "telefonos"."person_id" [delete: cascade]

// ── Relaciones con otros dominios (no se dibujan aquí) ──
//   persons -> aplications   [empleo]
//   persons -> chat_conversations   [chat]
//   persons -> chat_messages   [chat]
//   persons -> chat_notifications   [chat]
//   persons -> chat_conversation_participants   [chat]
//   persons -> chat_message_reads   [chat]
//   persons -> contracts   [empleo]
//   persons -> deliverables   [plantillas]
//   cantones -> direcciones   [organizacion]
//   paises -> direcciones   [organizacion]
//   provincias -> direcciones   [organizacion]
//   persons -> document_attachments   [tareas]
//   persons -> document_signatures   [tareas]
//   persons -> document_version_uploads   [tareas]
//   persons -> document_workflow_observations   [tareas]
//   persons -> document_workflow_observations   [tareas]
//   paises -> documentos_identidad   [organizacion]
//   cargos -> fill_flow_steps   [plantillas]
//   persons -> fill_flow_steps   [plantillas]
//   persons -> fill_requests   [plantillas]
//   paises -> persons   [organizacion]
//   persons -> position_assignments   [organizacion]
//   cargos -> process_definition_series   [procesos]
//   persons -> process_runs   [procesos]
//   cargos -> process_target_rules   [procesos]
//   relation_unit_types -> role_assignment_relation_types   [organizacion]
//   position_assignments -> role_assignments   [organizacion]
//   units -> role_assignments   [organizacion]
//   cargos -> signature_flow_steps   [firmas]
//   persons -> signature_flow_steps   [firmas]
//   persons -> signature_requests   [firmas]
//   persons -> task_item_tenures   [tareas]
//   persons -> task_items   [tareas]
//   persons -> task_items   [tareas]
//   paises -> telefonos   [organizacion]
//   cargos -> unit_positions   [organizacion]
//   roles -> vacancy_visibility   [empleo]
//   persons -> signature_batch_jobs   [firmas]
//   persons -> task_item_tenures   [tareas]
