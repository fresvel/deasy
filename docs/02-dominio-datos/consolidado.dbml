// ============================================================================
// ARTEFACTO GENERADO — NO EDITAR A MANO.
//
// Lo produce `bash scripts/docs/gen-dbml.sh` levantando un PostgreSQL desechable,
// aplicando `backend/database/postgres_schema.sql` e introspeccionando la base.
// Cualquier cambio hecho aquí se pierde en la siguiente regeneración, y la puerta
// de CI (.github/workflows/docs-dbml.yml) lo detecta.
//
// ¿Quieres explicar qué SIGNIFICA una tabla o una columna?
//   -> docs/02-dominio-datos/anotaciones.json  (eso sí se escribe a mano)
// Diagramas por dominio: docs/02-dominio-datos/dominios/
// ============================================================================

Project deasy {
  database_type: 'PostgreSQL'
  Note: '''Modelo de datos de Deasy. 67 tablas. El color de cabecera indica el dominio.'''
}

Table "actions" {
  "id" int4 [pk, not null, increment]
  "code" varchar(40) [unique, not null]
  "name" varchar(120) [not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "aplications" {
  "id" int4 [pk, not null, increment]
  "person_id" int4 [not null]
  "vacancy_id" int4 [not null]
  "status" text [not null, check: `status = ANY (ARRAY['aplicado'::text, 'preseleccionado'::text, 'entrevista'::text, 'rechazado'::text, 'retirado'::text, 'seleccionado'::text])`, default: 'aplicado']
  "selected_flag" int2 [note: "columna generada (STORED)"]
  "applied_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "note" varchar(255)

  Indexes {
    (vacancy_id, person_id) [type: btree, unique, name: "uq_application_once"]
    (vacancy_id, selected_flag) [type: btree, unique, name: "uq_one_selected_per_vacancy"]
    (person_id, applied_at) [type: btree, name: "idx_applications_person_time"]
    (vacancy_id, status) [type: btree, name: "idx_applications_vacancy_status"]
  }
}

Table "cargo_role_map" {
  "id" int4 [pk, not null, increment]
  "role_id" int4 [not null]
  "cargo_id" int4 [not null]

  Indexes {
    (cargo_id, role_id) [type: btree, unique, name: "uq_cargo_role_map"]
  }
}

Table "cargos" {
  "id" int4 [pk, not null, increment]
  "code" varchar(120) [unique, not null]
  "name" varchar(120) [unique, not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "chat_conversation_participants" {
  "id" int8 [pk, not null, increment]
  "conversation_id" int8 [not null]
  "person_id" int4 [not null]
  "role" varchar(20) [not null, default: 'member']
  "joined_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "left_at" timestamp

  Indexes {
    (conversation_id, person_id) [type: btree, unique, name: "uq_chat_participant"]
    (person_id, conversation_id) [type: btree, name: "idx_chat_participant_person"]
  }
}

Table "chat_conversations" {
  "id" int8 [pk, not null, increment]
  "type" text [not null, check: `type = ANY (ARRAY['direct'::text, 'group'::text, 'thread'::text, 'process_thread'::text, 'unit'::text])`]
  "title" text
  "process_id" int4
  "scope_process_id" int4
  "scope_unit_id" int4
  "stable_key" varchar(255) [unique]
  "scope_current_definition_id" int4
  "scope_origin_definition_id" int4
  "created_by" int4 [not null]
  "last_message_id" int8
  "last_message_at" timestamp
  "archived_at" timestamp
  "mobile_summary" text
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (type, process_id) [type: btree, name: "idx_chat_conversations_process"]
  }
}

Table "chat_message_attachments" {
  "id" int8 [pk, not null, increment]
  "message_id" int8 [not null]
  "sort_order" int4 [not null, default: 0]
  "path" varchar(500) [not null]
  "filename" varchar(255) [not null]
  "mime" varchar(120)
  "size" int8 [not null, default: 0]

  Indexes {
    (message_id, sort_order) [type: btree, name: "idx_chat_attachments_message"]
  }
}

Table "chat_message_reads" {
  "message_id" int8 [not null]
  "person_id" int4 [not null]
  "read_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (message_id, person_id) [pk, type: btree, name: "chat_message_reads_pkey"]
  }
}

Table "chat_messages" {
  "id" int8 [pk, not null, increment]
  "conversation_id" int8 [not null]
  "sender_person_id" int4 [not null]
  "content" text [not null, default: '']
  "content_type" varchar(20) [not null, check: `(content_type)::text = ANY ((ARRAY['text'::character varying, 'system'::character varying, 'attachment'::character varying])::text[])`, default: 'text']
  "reply_to_message_id" int8
  "edited_at" timestamp
  "deleted_at" timestamp
  "delivery_state" varchar(20)
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (conversation_id, created_at) [type: btree, name: "idx_chat_messages_conversation"]
    (sender_person_id, created_at) [type: btree, name: "idx_chat_messages_sender"]
  }
}

Table "chat_notifications" {
  "id" int8 [pk, not null, increment]
  "recipient_person_id" int4 [not null]
  "type" varchar(80) [not null]
  "title" text [not null]
  "body" text [not null]
  "entity_type" varchar(40)
  "entity_id" varchar(64)
  "conversation_id" int8
  "message_id" int8
  "channel" varchar(20) [not null, default: 'in_app']
  "read_at" timestamp
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (recipient_person_id, created_at) [type: btree, name: "idx_chat_notif_recipient_created"]
    (recipient_person_id, read_at) [type: btree, name: "idx_chat_notif_recipient_read"]
  }
}

Table "contract_origin_recruitment" {
  "contract_id" int4 [pk, not null]
  "offer_id" int4 [unique, not null]
  "vacancy_id" int4 [unique, not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "contract_origin_renewal" {
  "contract_id" int4 [pk, not null]
  "renewed_from_contract_id" int4 [not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    renewed_from_contract_id [type: btree, name: "idx_renewed_from_contract"]
  }
}

Table "contract_origins" {
  "contract_id" int4 [pk, not null]
  "origin_type" text [not null, check: `origin_type = ANY (ARRAY['recruitment'::text, 'renewal'::text])`]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "contracts" {
  "id" int4 [pk, not null, increment]
  "person_id" int4 [not null]
  "position_id" int4 [not null]
  "relation_type" varchar(60) [not null]
  "dedication" varchar(30) [not null]
  "start_date" date [not null]
  "end_date" date
  "status" text [not null, check: `status = ANY (ARRAY['activo'::text, 'finalizado'::text, 'cancelado'::text])`, default: 'activo']
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (person_id, status) [type: btree, name: "idx_contracts_person_status"]
    (position_id, status) [type: btree, name: "idx_contracts_position_status"]
  }
}

Table "deliverables" {
  "id" int4 [pk, not null, increment]
  "code" varchar(180) [unique, not null]
  "display_name" varchar(180) [not null]
  "description" varchar(255)
  "owner_process_id" int4
  "owner_variation_key" varchar(120)
  "template_scope" text [not null, check: `template_scope = ANY (ARRAY['official'::text, 'ad_hoc'::text])`, default: 'official']
  "template_seed_id" int4
  "owner_person_id" int4
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (owner_process_id, owner_variation_key) [type: btree, name: "idx_deliverables_owner"]
  }

  Note: '''El ENTREGABLE como identidad estable (el \'libro\'). Sus versiones son `template_artifacts` (las \'ediciones\'): la identidad vive aquí y sólo aquí.'''
}

Table "document_attachments" {
  "id" int4 [pk, not null, increment]
  "document_version_id" int4 [not null]
  "kind" text [not null, check: `kind = ANY (ARRAY['annex'::text, 'evidence'::text, 'source'::text, 'other'::text])`, default: 'annex']
  "file_path" varchar(255) [not null]
  "file_name" varchar(255) [not null]
  "mime_type" varchar(120)
  "size_bytes" int8
  "description" varchar(255)
  "uploaded_by_person_id" int4
  "sort_order" int4 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    uploaded_by_person_id [type: btree, name: "idx_document_attachments_uploader"]
    (document_version_id, sort_order) [type: btree, name: "idx_document_attachments_version"]
  }
}

Table "document_fill_flows" {
  "id" int4 [pk, not null, increment]
  "fill_flow_template_id" int4 [not null]
  "document_version_id" int4 [unique, not null]
  "status" text [not null, check: `status = ANY (ARRAY['pending'::text, 'in_progress'::text, 'approved'::text, 'rejected'::text, 'cancelled'::text])`, default: 'pending']
  "current_step_order" int4
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "document_signatures" {
  "id" int4 [pk, not null, increment]
  "signature_request_id" int4
  "document_version_id" int4 [not null]
  "signer_user_id" int4 [not null]
  "signature_status_id" int4 [not null]
  "note_short" varchar(255)
  "signed_file_path" varchar(255)
  "signed_at" timestamp
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "document_version_uploads" {
  "id" int4 [pk, not null, increment]
  "document_version_id" int4 [not null]
  "minor" int4 [not null]
  "file_path" varchar(255) [not null]
  "file_name" varchar(255)
  "mime_type" varchar(120)
  "size_bytes" int8
  "uploaded_by_person_id" int4
  "note" varchar(255)
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (document_version_id, minor) [type: btree, unique, name: "uq_document_version_uploads"]
    uploaded_by_person_id [type: btree, name: "idx_document_version_uploads_person"]
  }

  Note: '''Cada SUBIDA del archivo de un entregable: la version MENOR. Guarda quien lo subio, que fichero y cuando. Antes no constaba en ninguna parte quien elaboro un documento — `working_file_path` se sobrescribe— mientras que un ANEXO si guardaba su autor. Ojo: en MinIO nunca se perdio un fichero (el nombre lleva sello de tiempo y UUID); lo que se perdia era el PUNTERO.'''
}

Table "document_versions" {
  "id" int4 [pk, not null, increment]
  "task_item_id" int4 [not null, note: '''Cuelga del ENTREGABLE. Hasta el 2026-08-23 habia una tabla `documents` en medio, en relacion 1:1 estricta y sin una sola columna propia.''']
  "version" int4 [not null, default: 1, note: '''La RONDA: un intento completo del flujo (llenar -> firmar). Entero desde el 2026-08-23; antes era decimal y el numero mentia, porque 0.1 y 0.2 parecian correcciones del mismo documento y eran dos rondas, la primera cancelada entera. Las CORRECCIONES son el segundo digito y viven en `document_version_uploads`.''']
  "version_minor" int4 [not null, default: 0]
  "version_label" text [note: "columna generada (STORED)"]
  "template_artifact_id" int4
  "payload_hash" varchar(64)
  "payload_object_path" varchar(255)
  "working_file_path" varchar(255)
  "final_file_path" varchar(255)
  "format" varchar(40)
  "render_engine" varchar(80)
  "status" varchar(30) [not null, default: 'Borrador']
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (task_item_id, version) [type: btree, unique, name: "uq_document_versions"]
    template_artifact_id [type: btree, name: "idx_document_versions_artifact"]
    task_item_id [type: btree, name: "idx_document_versions_item"]
  }
}

Table "document_workflow_observations" {
  "id" int4 [pk, not null, increment]
  "task_item_id" int4 [not null]
  "document_version_id" int4 [not null]
  "fill_request_id" int4
  "signature_request_id" int4
  "phase" text [not null, check: `phase = ANY (ARRAY['review'::text, 'signature'::text])`]
  "kind" text [not null, check: `kind = ANY (ARRAY['observation'::text, 'return_reason'::text, 'rejection_reason'::text, 'internal_note'::text])`, default: 'observation']
  "message" text [not null]
  "author_person_id" int4 [not null]
  "resolved_by_person_id" int4
  "resolved_at" timestamp
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    author_person_id [type: btree, name: "idx_document_workflow_observations_author"]
    fill_request_id [type: btree, name: "idx_document_workflow_observations_fill_request"]
    (task_item_id, created_at) [type: btree, name: "idx_document_workflow_observations_item"]
    signature_request_id [type: btree, name: "idx_document_workflow_observations_signature_request"]
    (document_version_id, created_at) [type: btree, name: "idx_document_workflow_observations_version"]
  }
}

Table "dossier_items" {
  "id" int8 [pk, not null, increment]
  "dossier_id" int8 [not null]
  "section" varchar(20) [not null]
  "data" jsonb [not null, default: `{}`]
  "url_documento" text [not null, default: '']
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (dossier_id, section, id) [type: btree, name: "idx_dossier_items"]
  }
}

Table "dossiers" {
  "id" int8 [pk, not null, increment]
  "person_id" int4 [unique, not null]
  "cedula" varchar(20)
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    cedula [type: btree, name: "idx_dossiers_cedula"]
  }

  Note: '''El expediente de una persona. Sustituye a la colección de MongoDB retirada en la migración a PostgreSQL; enlaza por cédula.'''
}

Table "email_verification_codes" {
  "id" int8 [pk, not null, increment]
  "person_id" int4 [not null]
  "code_hash" varchar(255) [not null]
  "expires_at" timestamp [not null]
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]

  Indexes {
    expires_at [type: btree, name: "idx_evc_expires_at"]
    person_id [type: btree, name: "idx_evc_person_id"]
  }
}

Table "fill_flow_steps" {
  "id" int4 [pk, not null, increment]
  "fill_flow_template_id" int4 [not null]
  "step_order" int4 [not null]
  "code" varchar(120)
  "name" varchar(180)
  "resolver_type" text [not null, check: `resolver_type = ANY (ARRAY['task_assignee'::text, 'specific_person'::text, 'cargo_in_scope'::text])`, default: 'task_assignee']
  "assigned_person_id" int4
  "unit_scope_type" text [not null, check: `unit_scope_type = ANY (ARRAY['unit_exact'::text, 'unit_subtree'::text, 'unit_type'::text, 'all_units'::text, 'context_exact'::text])`, default: 'unit_exact']
  "unit_id" int4
  "unit_type_id" int4
  "relation_type_id" int4
  "cargo_id" int4
  "position_id" int4
  "selection_mode" text [not null, check: `selection_mode = ANY (ARRAY['auto_one'::text, 'auto_all'::text, 'manual'::text])`, default: 'auto_one']
  "is_required" int2 [not null, default: 1]
  "can_reject" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (fill_flow_template_id, step_order) [type: btree, unique, name: "uq_fill_flow_steps"]
  }
}

Table "fill_flow_templates" {
  "id" int4 [pk, not null, increment]
  "process_definition_template_id" int4
  "task_item_id" int4
  "template_artifact_id" int4 [note: '''El flujo AUTORADO de la plantilla (frente 0.8, sub-paso 1). Al escribir esta nota era un cajón abierto y vacío: la columna existe y todavía nadie la lee ni la escribe.''']
  "name" varchar(180) [not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    template_artifact_id [type: btree, name: "idx_fill_flow_templates_artifact"]
    task_item_id [type: btree, name: "idx_fill_flow_templates_task_item"]
  }

  Note: '''Cabecera de un flujo de entrega. Cuelga de UNO de tres portadores, y NO son excluyentes (por eso no hay CHECK): por vínculo (`process_definition_template_id`), de runtime (`task_item_id`) o autorado en la plantilla (`template_artifact_id`, frente 0.8).'''
}

Table "fill_requests" {
  "id" int4 [pk, not null, increment]
  "document_fill_flow_id" int4 [not null]
  "fill_flow_step_id" int4 [not null]
  "assigned_person_id" int4
  "status" text [not null, check: `status = ANY (ARRAY['pending'::text, 'in_progress'::text, 'approved'::text, 'rejected'::text, 'returned'::text, 'cancelled'::text])`, default: 'pending']
  "is_manual" int2 [not null, default: 0]
  "requested_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "responded_at" timestamp
  "response_note" varchar(255)

  Indexes {
    (document_fill_flow_id, fill_flow_step_id, assigned_person_id) [type: btree, unique, name: "uq_fill_requests"]
    (document_fill_flow_id, fill_flow_step_id) [type: btree, name: "idx_fill_requests_step"]
  }
}

Table "offers" {
  "id" int4 [pk, not null, increment]
  "application_id" int4 [not null]
  "status" text [not null, check: `status = ANY (ARRAY['enviada'::text, 'aceptada'::text, 'rechazada'::text, 'retractada'::text, 'expirada'::text])`, default: 'enviada']
  "active_flag" int2 [note: "columna generada (STORED)"]
  "terms_snapshot" text
  "sent_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "responded_at" timestamp
  "expires_at" timestamp
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (application_id, active_flag) [type: btree, unique, name: "uq_one_active_offer_per_application"]
    (application_id, status) [type: btree, name: "idx_offers_application_status"]
  }
}

Table "password_reset_codes" {
  "id" int8 [pk, not null, increment]
  "person_id" int4 [not null]
  "code_hash" varchar(255) [not null]
  "expires_at" timestamp [not null]
  "used" int2 [default: 0]
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]

  Indexes {
    expires_at [type: btree, name: "idx_prc_expires_at"]
    person_id [type: btree, name: "idx_prc_person_id"]
  }
}

Table "permissions" {
  "id" int4 [pk, not null, increment]
  "resource_id" int4 [not null]
  "action_id" int4 [not null]
  "code" varchar(120) [unique, not null]
  "description" varchar(255)
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (resource_id, action_id) [type: btree, unique, name: "uq_permissions_resource_action"]
    action_id [type: btree, name: "idx_permissions_action"]
    resource_id [type: btree, name: "idx_permissions_resource"]
  }
}

Table "person_certificates" {
  "id" int4 [pk, not null, increment]
  "person_id" int4 [not null]
  "label" varchar(180) [not null]
  "original_filename" varchar(255) [not null]
  "bucket" varchar(120) [not null]
  "object_name" varchar(500) [not null]
  "is_default" int2 [not null, default: 0]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (person_id, is_default) [type: btree, name: "idx_person_certificates_default"]
    person_id [type: btree, name: "idx_person_certificates_person"]
  }
}

Table "persons" {
  "id" int4 [pk, not null, increment]
  "cedula" varchar(20) [unique]
  "first_name" varchar(120) [not null]
  "last_name" varchar(120) [not null]
  "email" varchar(180) [unique]
  "whatsapp" varchar(30)
  "direccion" varchar(255)
  "pais" varchar(80)
  "pais_residencia" varchar(80)
  "provincia_residencia" varchar(120)
  "ciudad_residencia" varchar(120)
  "calle_primaria" varchar(180)
  "calle_secundaria" varchar(180)
  "codigo_postal" varchar(30)
  "password_hash" varchar(255) [not null]
  "status" text [check: `status = ANY (ARRAY['Inactivo'::text, 'Activo'::text, 'Verificado'::text, 'Reportado'::text])`, default: 'Inactivo']
  "verify_email" int2 [default: 0]
  "verify_whatsapp" int2 [default: 0]
  "photo_url" text
  "is_active" int2 [not null, default: 1]
  "token" varchar(10) [unique, not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "position_assignments" {
  "id" int4 [pk, not null, increment]
  "position_id" int4 [not null]
  "person_id" int4 [not null]
  "start_date" date [not null]
  "end_date" date
  "is_current" int2 [not null, default: 1]
  "current_flag" int2 [note: "columna generada (STORED)"]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (position_id, current_flag) [type: btree, unique, name: "uq_position_current"]
    (person_id, is_current) [type: btree, name: "idx_assignments_person_current"]
  }
}

Table "process_definition_period_types" {
  "id" int4 [pk, not null, increment]
  "process_definition_id" int4 [not null]
  "term_type_id" int4 [not null]
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (process_definition_id, term_type_id) [type: btree, unique, name: "uq_process_definition_period_types"]
    (process_definition_id, is_active) [type: btree, name: "idx_process_definition_period_types_lookup"]
    term_type_id [type: btree, name: "idx_process_definition_period_types_term_type"]
  }
}

Table "process_definition_series" {
  "id" int4 [pk, not null, increment]
  "source_type" text [not null, check: `source_type = ANY (ARRAY['unit_type'::text, 'cargo'::text, 'default'::text])`, default: 'default']
  "unit_type_id" int4
  "cargo_id" int4
  "code" varchar(120) [unique, not null]
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    is_active [type: btree, name: "idx_process_definition_series_state"]
  }
}

Table "process_definition_templates" {
  "id" int4 [pk, not null, increment]
  "process_definition_id" int4 [not null]
  "template_artifact_id" int4 [not null]
  "sort_order" int4 [not null, default: 1]
  "item_mode" text [not null, check: `item_mode = ANY (ARRAY['single'::text, 'replicated'::text, 'routed'::text])`, default: 'single', note: '''Los tres modos de emisión. `single`: entregable y flujo predefinidos, 1 instancia al lanzar. `replicated`: flujo predefinido, el responsable crea N réplicas etiquetadas que lo heredan. `routed`: SIN flujo predefinido — el usuario define entrega y firma al instanciar (runtime).''']
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (process_definition_id, template_artifact_id) [type: btree, unique, name: "uq_process_definition_templates"]
  }

  Note: '''El vínculo entre un proceso configurado y una plantilla. Aquí vive `item_mode`, que decide cuántas instancias se crean y quién define el flujo.'''
}

Table "process_definition_versions" {
  "id" int4 [pk, not null, increment]
  "process_id" int4 [not null]
  "series_id" int4 [not null]
  "variation_key" varchar(120) [not null, default: 'general']
  "definition_version" varchar(20) [not null]
  "name" varchar(180) [not null]
  "description" varchar(255)
  "status" text [not null, check: `status = ANY (ARRAY['draft'::text, 'active'::text, 'retired'::text])`, default: 'draft']
  "active_series_flag" int2 [note: "columna generada (STORED)"]
  "effective_from" date [not null]
  "effective_to" date
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (process_id, variation_key, active_series_flag) [type: btree, unique, name: "uq_process_definition_one_active_series"]
    (process_id, variation_key, definition_version) [type: btree, unique, name: "uq_process_definition_versions_series"]
    (process_id, variation_key, status, effective_from) [type: btree, name: "idx_process_definition_versions_status"]
  }
}

Table "process_runs" {
  "id" int4 [pk, not null, increment]
  "process_definition_id" int4 [not null]
  "term_id" int4
  "run_mode" text [not null, check: `run_mode = ANY (ARRAY['automatic'::text, 'manual'::text])`, default: 'manual']
  "source_run_id" int4
  "created_by_user_id" int4
  "reason" varchar(255)
  "status" text [not null, check: `status = ANY (ARRAY['pending'::text, 'active'::text, 'completed'::text, 'cancelled'::text])`, default: 'active']
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (process_definition_id, status) [type: btree, name: "idx_process_runs_definition"]
    term_id [type: btree, name: "idx_process_runs_term"]
  }
}

Table "process_target_rules" {
  "id" int4 [pk, not null, increment]
  "process_definition_id" int4 [not null]
  "unit_scope_type" text [not null, check: `unit_scope_type = ANY (ARRAY['unit_exact'::text, 'unit_subtree'::text, 'unit_type'::text, 'all_units'::text])`, default: 'unit_exact']
  "unit_id" int4
  "unit_type_id" int4
  "cargo_id" int4
  "position_id" int4
  "recipient_policy" text [not null, check: `recipient_policy = ANY (ARRAY['all_matches'::text, 'unit_head'::text, 'exact_position'::text])`, default: 'all_matches']
  "priority" int4 [not null, default: 1]
  "is_active" int2 [not null, default: 1]
  "effective_from" date
  "effective_to" date
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (process_definition_id, is_active) [type: btree, name: "idx_process_target_rules_definition"]
    (unit_scope_type, unit_id, unit_type_id) [type: btree, name: "idx_process_target_rules_scope"]
  }

  Note: '''El eje de REPARTO: a quién alcanza el proceso. La serie siembra y blinda el cargo de la regla.'''
}

Table "processes" {
  "id" int4 [pk, not null, increment]
  "name" varchar(180) [not null]
  "slug" varchar(180) [unique, not null]
  "parent_id" int4
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Note: '''Serie → regla → flujo. La SERIE nombra el proceso, la REGLA reparte su alcance (a qué unidades/cargos llega) y el FLUJO reparte los pasos. Los tres ejes son independientes.'''
}

