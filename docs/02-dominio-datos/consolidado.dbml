  "required_signers_min" int4
  "required_signers_max" int4
  "is_required" int2 [not null, default: 1]
  "anchor_refs" jsonb
  "signers" jsonb
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (template_id, step_order) [type: btree, unique, name: "uq_signature_flow_steps"]
    (template_id, slot) [type: btree, unique, name: "uq_signature_flow_steps_slot"]
