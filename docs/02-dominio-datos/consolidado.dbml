    position_id [type: btree, name: "idx_signature_flow_steps_position"]
    unit_id [type: btree, name: "idx_signature_flow_steps_unit"]
    unit_type_id [type: btree, name: "idx_signature_flow_steps_unit_type"]
  }
}

