Table "unit_relations" {
  "id" int4 [pk, not null, increment]
  "relation_type_id" int4 [not null]
  "parent_unit_id" int4 [not null]
  "child_unit_id" int4 [not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (parent_unit_id, child_unit_id, relation_type_id) [type: btree, unique, name: "unit_relations_uq"]
    (child_unit_id, relation_type_id) [type: btree, unique, name: "uq_unit_relations_child_type"]
    child_unit_id [type: btree, name: "idx_unit_relations_child"]
    parent_unit_id [type: btree, name: "idx_unit_relations_parent"]
  }
}

Table "unit_types" {
  "id" int4 [pk, not null, increment]
  "name" varchar(120) [not null]
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table "units" {
  "id" int4 [pk, not null, increment]
  "name" varchar(180) [not null]
  "label" varchar(75)
  "slug" varchar(180) [not null]
  "unit_type_id" int4 [not null]
  "is_active" int2 [not null, default: 1]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    unit_type_id [type: btree, name: "idx_units_unit_type"]
  }
}

Table "vacancies" {
  "id" int4 [pk, not null, increment]
  "title" varchar(180) [not null]
  "category" varchar(120)
  "dedication" varchar(30) [not null]
  "relation_type" varchar(60) [not null]
  "status" text [not null, check: `status = ANY (ARRAY['abierta'::text, 'cubierta'::text, 'cerrada'::text, 'cancelada'::text])`, default: 'abierta']
  "open_flag" int2 [note: "columna generada (STORED)"]
  "profile_ref" varchar(64)
  "opened_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "closed_at" timestamp
  "position_id" int4 [not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (position_id, open_flag) [type: btree, unique, name: "uq_one_open_vacancy_per_position"]
    (position_id, status) [type: btree, name: "idx_vacancies_position_status"]
  }
}

Table "vacancy_visibility" {
  "id" int4 [pk, not null, increment]
  "vacancy_id" int4 [not null]
  "unit_id" int4
  "role_id" int4
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    role_id [type: btree, name: "idx_vacancy_visibility_role"]
    unit_id [type: btree, name: "idx_vacancy_visibility_unit"]
    vacancy_id [type: btree, name: "idx_vacancy_visibility_vacancy"]
  }
}

