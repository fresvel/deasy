{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "lint": "pnpm run build && eslint . && node scripts/check-no-dark.mjs && node scripts/check-orphan-classes.mjs && node scripts/check-no-arbitrary.mjs && node scripts/check-color-theme.mjs && node scripts/css-prune.mjs && node scripts/check-variants.mjs && node scripts/check-row-actions.mjs && node scripts/contraste.mjs --gate && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:no-dark": "node scripts/check-no-dark.mjs",
    "check:orphan-classes": "node scripts/check-orphan-classes.mjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage && sed -i 's|^SF:|SF:frontend/|' coverage/lcov.info",
    "test:unit:watch": "vitest",
    "check:no-arbitrary": "node scripts/check-no-arbitrary.mjs",
    "check:contraste": "node scripts/contraste.mjs --gate",
    "check:color-theme": "node scripts/check-color-theme.mjs",
    "check:css-prune": "node scripts/css-prune.mjs",
    "check:variants": "node scripts/check-variants.mjs",
    "check:row-actions": "node scripts/check-row-actions.mjs src"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.41.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "axios": "^1.14.0",
    "dagre": "^0.8.5",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "marked": "^17.0.5",
    "pdfjs-dist": "^5.6.205",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@swc/core": "^1.15.24",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^26.1.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.2",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.0.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
