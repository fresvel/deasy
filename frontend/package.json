    "axios": "^1.14.0",
    "dagre": "^0.8.5",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "marked": "^17.0.5",
    "pdfjs-dist": "^5.6.205",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@swc/core": "^1.15.24",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-vue": "^6.0.5",
