    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "lint": "pnpm run build && eslint . && node scripts/check-no-dark.mjs && node scripts/check-orphan-classes.mjs && node scripts/check-no-arbitrary.mjs && node scripts/check-color-theme.mjs && node scripts/css-prune.mjs && node scripts/check-selector-reach.mjs && node scripts/check-variants.mjs && node scripts/check-row-actions.mjs && node scripts/check-filter-actions.mjs && node scripts/check-dismiss-actions.mjs && node scripts/check-paging-actions.mjs && node scripts/check-destructive-actions.mjs && node scripts/check-nav-actions.mjs && node scripts/check-buttons-g9-g11.mjs && node scripts/check-general-actions.mjs && node scripts/check-icon-box.mjs && node scripts/check-state-tone.mjs && node scripts/check-overrides.mjs && node scripts/check-control-size.mjs && node scripts/check-z-index.mjs && node scripts/check-layer-debt.mjs && node scripts/contraste.mjs --gate && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:no-dark": "node scripts/check-no-dark.mjs",
    "check:orphan-classes": "node scripts/check-orphan-classes.mjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage && sed -i 's|^SF:|SF:frontend/|' coverage/lcov.info",
    "test:unit:watch": "vitest",
    "check:no-arbitrary": "node scripts/check-no-arbitrary.mjs",
    "check:contraste": "node scripts/contraste.mjs --gate",
    "check:color-theme": "node scripts/check-color-theme.mjs",
    "check:css-prune": "node scripts/css-prune.mjs",
    "check:variants": "node scripts/check-variants.mjs",
    "check:row-actions": "node scripts/check-row-actions.mjs src",
    "check:filter-actions": "node scripts/check-filter-actions.mjs src",
    "check:dismiss-actions": "node scripts/check-dismiss-actions.mjs src",
    "check:paging-actions": "node scripts/check-paging-actions.mjs src",
    "check:destructive-actions": "node scripts/check-destructive-actions.mjs src",
    "check:nav-actions": "node scripts/check-nav-actions.mjs src",
    "check:buttons-g9-g11": "node scripts/check-buttons-g9-g11.mjs src",
    "check:general-actions": "node scripts/check-general-actions.mjs src",
    "check:icon-box": "node scripts/check-icon-box.mjs src",
    "check:selector-reach": "node scripts/check-selector-reach.mjs"
  },
