RABBITMQ_HTTP_API=http://localhost:15672/api
RABBITMQ_HTTP_USER=deasy
RABBITMQ_HTTP_PASSWORD=CAMBIAR__definir_en_docker/.env.<entorno>.runtime

# --- RabbitMQ: credenciales propias, NUNCA `guest` ---
# El broker ya no se publica al host (solo red interna de compose) y `guest` vuelve a estar
# restringido a loopback. Estas dos variables son las que usan backend y signer para conectar,
# y las que crean el usuario en el PRIMER arranque del broker.
RABBITMQ_USER=deasy
RABBITMQ_PASSWORD=CAMBIAR__definir_en_docker/.env.<entorno>.runtime

# Clave que los microservicios de Deasy presentan al backend para llegar a `/internal/`.
# Sin ella, esas rutas responden 503 (cerradas), no 200: un despliegue al que se le
# olvido ponerla no debe quedar con las rutas internas al aire.
# Donde escucha el servicio de canales, para PREGUNTARLE como estan (C7). En la red interna y sin
# puerto publicado: al navegador no se le ha perdido nada ahi.
CHANNELS_URL=http://channels:3050
INTERNAL_SERVICE_KEY=cambiar-en-cada-entorno

# Canales por los que se puede probar que un telefono es tuyo. Cada uno se activa por SEPARADO:
# lo que este vacio no se ofrece, y con los DOS vacios la peticion responde 503 en vez de
# devolver un 200 con enlaces nulos.
#
# ⚠️ Hubo un tercero, SMS_NUMERO, y se DESCARTO el 2026-09-01 para siempre: el SMS entrante NO
# prueba el numero -- su cabecera de origen la rellena el emisor. No lo reintroduzcas sin leer
# antes el frente 15 del plan.
#   TELEGRAM_BOT_USERNAME  el nombre del bot SIN la arroba          -> https://t.me/<bot>?start=<llave>
#   WHATSAPP_NUMERO        el numero DEDICADO, internacional sin +  -> https://wa.me/<numero>?text=<llave>
TELEGRAM_BOT_USERNAME=
WHATSAPP_NUMERO=

# ── Correo saliente ─────────────────────────────────────────────────────────────────────────
# HACEN FALTA EN PRODUCCION: sin ellas nadie puede registrarse, porque la verificacion del
# correo es obligatoria. Los VALORES no van en este fichero --se publica en el repositorio--:
# van en el fichero al que apunte `DEASY_CONTAINER_ENV_FILE`, fuera del arbol de git.
#
#   SMTP_HOST   el servidor de salida        p. ej. smtp.institucion.edu.ec
#   SMTP_PORT   587 (STARTTLS) o 465 (TLS desde el saludo)
#   SMTP_USER   la cuenta de servicio        NO una cuenta personal: se va con quien la tenga
#   SMTP_PASS   su contrasena
#   SMTP_FROM   el remitente visible         Deasy <no-responder@institucion.edu.ec>
#
# ⚠️ EL DOMINIO DEL REMITENTE TIENE QUE SER UNO QUE CONTROLEIS, y con SPF y DKIM publicados.
# Sin eso los codigos de verificacion acaban en spam, y el registro se rompe EN SILENCIO: la
# persona no recibe nada y no hay error en ninguna parte que lo diga.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
