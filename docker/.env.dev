DOCS_PORT=4321
ORIGIN1=https://localhost:8443
ORIGIN2=https://127.0.0.1:8443
SWAGGER_SERVER_URL=/api/deasy/v1


# PostgreSQL (motor destino de la migración; convive con MariaDB en la transición)
POSTGRES_DB=deasy
