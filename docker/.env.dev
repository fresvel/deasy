MINIO_SPOOL_BUCKET=deasy-spool
MINIO_SIGNATURES_PREFIX=Firmas
MINIO_USERS_BUCKET=deasy-users
MINIO_USERS_PREFIX=Users
MINIO_DOSSIER_BUCKET=deasy-dossier
MINIO_DOSSIER_PREFIX=Dosier

# -- Los textos legales (LOPDP): DOS buckets, y uno de ellos NO SE PUEDE DESHACER -------------
# El borrador se versiona SIN bloqueo; el publicado va a un bucket con Object Lock en modo
# COMPLIANCE, donde lo que entra no lo borra NADIE, ni el usuario root de MinIO.
#
# ADVERTENCIA: el bloqueo es DE CREACION E IRREVERSIBLE. A un bucket creado sin `--with-lock`
# no se le puede anadir despues, ni activando antes el versionado. Por eso, si el bucket de
# archivo ya existe y no admite bloqueo, `docker/minio/bootstrap.sh` FALLA a proposito en vez
# de seguir en silencio: seguir aparentaria funcionar durante anos.
#
# ADVERTENCIA: la retencion NO es configurable desde la aplicacion, y no es un olvido. Un
# bloqueo COMPLIANCE no se puede ACORTAR, asi que un ajuste que la bajara pareceria guardarse
# y no haria nada. Es configuracion de despliegue, y por eso vive aqui.
#
# Aqui es 1 dia porque `test:char:run` resetea la base pero NO MinIO: con los 3650 de
# produccion, cada corrida dejaria documentos indelebles acumulandose para siempre.
MINIO_LEGAL_BUCKET=deasy-legal
MINIO_LEGAL_DRAFTS_BUCKET=deasy-legal-borradores
MINIO_LEGAL_RETENTION_MODE=COMPLIANCE
MINIO_LEGAL_RETENTION_DAYS=1

RABBITMQ_HTTP_API=http://rabbitmq:15672/api
RABBITMQ_HTTP_USER=deasy
RABBITMQ_HTTP_PASSWORD=dev_rCWJGsQ5GRlJdhQMyllCl26o

# Realtime de chat vía WebSockets (Socket.IO) montado sobre el backend HTTP.
CHAT_REALTIME_ENABLED=1

PYHANKO_TSA_URL=
SIGNER_EMBED_VALIDATION_INFO=1
SIGNER_USE_PADES_LTA=0
SIGNER_USE_GHOSTSCRIPT=1

# --- RabbitMQ: credenciales propias, NUNCA `guest` ---
# El broker ya no se publica al host (solo red interna de compose) y `guest` vuelve a estar
# restringido a loopback. Estas dos variables son las que usan backend y signer para conectar,
# y las que crean el usuario en el PRIMER arranque del broker.
RABBITMQ_USER=deasy
RABBITMQ_PASSWORD=dev_rCWJGsQ5GRlJdhQMyllCl26o

# Azimutt (explorador del modelo, perfil `explorer`). Secreto de DESARROLLO: esta pila no
# se publica. Para un despliegue real hay que generar uno propio de >=64 bytes.
AZIMUTT_SECRET_KEY_BASE=dev_only_no_publicar_5d8f3a1c9b4e7206af13c58de9207b64a3f1e8c05d729b46
AZIMUTT_PORT=4700
MAILPIT_PORT=8025

# El correo saliente. En DEV apunta al buzon local (`mailpit`), que no reenvia nada a internet:
# no hay forma de escribirle sin querer a una persona de verdad. En un entorno real, estas tres
# van en `.env.<entorno>.runtime` con las credenciales, que aqui NO caben (este fichero se publica).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Deasy (desarrollo) <no-responder@deasy.local>

# Clave que los microservicios de Deasy presentan al backend para llegar a `/internal/`.
# Sin ella, esas rutas responden 503 (cerradas), no 200: un despliegue al que se le
# olvido ponerla no debe quedar con las rutas internas al aire.
# Donde escucha el servicio de canales, para PREGUNTARLE como estan (C7). En la red interna y sin
# puerto publicado: al navegador no se le ha perdido nada ahi.
CHANNELS_URL=http://channels:3050
INTERNAL_SERVICE_KEY=cambiar-en-cada-entorno

# Canales por los que se puede probar que un telefono es tuyo. Cada uno se activa por SEPARADO:
# lo que este vacio no se ofrece, y con los DOS vacios la peticion responde 503 en vez de
# devolver un 200 con enlaces nulos.
#
# ⚠️ Hubo un tercero, SMS_NUMERO, y se DESCARTO el 2026-09-01 para siempre: el SMS entrante NO
# prueba el numero -- su cabecera de origen la rellena el emisor. No lo reintroduzcas sin leer
# antes el frente 15 del plan.
#   TELEGRAM_BOT_USERNAME  el nombre del bot SIN la arroba          -> https://t.me/<bot>?start=<llave>
#   WHATSAPP_NUMERO        el numero DEDICADO, internacional sin +  -> https://wa.me/<numero>?text=<llave>
# ⚠️ ESTO ES UN MARCADOR, y este fichero ESTA VERSIONADO. El bot de verdad se configura en
# `docker/.env.dev.runtime` (ignorado por git) copiando `docker/.env.dev.runtime.example`, que
# ademas es donde va el TOKEN — aqui no cabe: quien tiene el token lee todo lo que se le escriba
# al bot. El marcador sirve para que el camino de composicion del enlace se ejecute en las
# pruebas; el enlace no lleva a ninguna parte.
TELEGRAM_BOT_USERNAME=deasy_verificacion_bot
WHATSAPP_NUMERO=

# ── La barrida de conversaciones (LOPDP) ────────────────────────────────────────────────────
# Borra las conversaciones de WhatsApp de quien NUNCA verifico un telefono: nunca acepto nada, asi
# que no hay base legal para conservarlas. Se conserva la de quien SI, que esta cubierta por su
# consentimiento.
#
# ⚠️ VIENE APAGADA, y solo se enciende con el valor `1`. Borrar SE SINCRONIZA AL TELEFONO vinculado
# y es IRREVERSIBLE. En desarrollo la linea suele ser un telefono personal con su propia agenda: la
# primera pasada se llevaria conversaciones que no tienen nada que ver con el sistema.
#
# ⚠️ Se enciende EN PRODUCCION, y con una condicion: que la linea dedicada sea una cuenta LIMPIA,
# sin agenda ni historial previos. Decision del dueño, 2026-09-02.
BARRIDA_CONVERSACIONES=
