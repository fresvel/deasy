PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
NGINX_TLS_CERT_DIR=public
PUBLIC_INGRESS_NETWORK=deasy_public_ingress
BOOTSTRAP_SERVER_NAMES=fresvel.com www.fresvel.com qa.fresvel.com
PROD_SERVER_NAMES=fresvel.com www.fresvel.com
QA_SERVER_NAME=qa.fresvel.com
PROD_FRONTEND_UPSTREAM=deasy-prod-frontend:8080
PROD_BACKEND_UPSTREAM=deasy-prod-backend:3030
QA_FRONTEND_UPSTREAM=deasy-qa-frontend:8080
QA_BACKEND_UPSTREAM=deasy-qa-backend:3030

# Clave que los microservicios de Deasy presentan al backend para llegar a `/internal/`.
# Sin ella, esas rutas responden 503 (cerradas), no 200: un despliegue al que se le
# olvido ponerla no debe quedar con las rutas internas al aire.
INTERNAL_SERVICE_KEY=cambiar-en-cada-entorno

# Canales por los que se puede probar que un telefono es tuyo. Cada uno se activa por SEPARADO:
# lo que este vacio no se ofrece, y con los tres vacios la peticion responde 503 en vez de
# devolver un 200 con tres enlaces nulos.
#   TELEGRAM_BOT_USERNAME  el nombre del bot SIN la arroba          -> https://t.me/<bot>?start=<llave>
#   WHATSAPP_NUMERO        el numero DEDICADO, internacional sin +  -> https://wa.me/<numero>?text=<llave>
#   SMS_NUMERO             el numero al que el usuario ESCRIBE      (el gasto es suyo, y por eso no
#                          hay ataque de coste contra nosotros)
TELEGRAM_BOT_USERNAME=
WHATSAPP_NUMERO=
SMS_NUMERO=
