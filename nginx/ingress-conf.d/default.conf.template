server {
  listen 80 default_server;
  server_name _;

  resolver 127.0.0.11 ipv6=off valid=10s;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name _;

  resolver 127.0.0.11 ipv6=off valid=10s;

  ssl_certificate     ${TLS_CERT_PATH};
  ssl_certificate_key ${TLS_KEY_PATH};
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_timeout 1d;
  ssl_session_cache   shared:SSL:10m;
  ssl_prefer_server_ciphers off;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }

  return 404;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${PROD_SERVER_NAMES};

  resolver 127.0.0.11 ipv6=off valid=10s;
  set $prod_backend_upstream ${PROD_BACKEND_UPSTREAM};
  set $prod_frontend_upstream ${PROD_FRONTEND_UPSTREAM};

  ssl_certificate     ${TLS_CERT_PATH};
  ssl_certificate_key ${TLS_KEY_PATH};
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_timeout 1d;
  ssl_session_cache   shared:SSL:10m;
  ssl_prefer_server_ciphers off;

  client_max_body_size 20m;

  location = /api {
    return 301 /api/;
  }

  location /api/ {
    # 200m como en el proxy de aplicacion, y por el mismo motivo: `POST /sign/batch/start` manda
    # el lote completo en un multipart. El porque, medido, esta en
    # `nginx/app-conf.d/default.conf.template`; si una de las dos sube, la otra tambien, o el
    # publico rechaza lo que el local acepta.
    client_max_body_size 200m;

    rewrite ^/api/(.*)$ /$1 break;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass http://$prod_backend_upstream;
  }

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass http://$prod_frontend_upstream;
  }
}

