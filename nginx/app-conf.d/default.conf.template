server {
  listen 80;
  server_name _;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }

  location / {
    return 301 https://$host${HTTPS_REDIRECT_PORT}$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name _;

  ssl_certificate     ${TLS_CERT_PATH};
  ssl_certificate_key ${TLS_KEY_PATH};
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_timeout 1d;
  ssl_session_cache   shared:SSL:10m;
  ssl_prefer_server_ciphers off;

  # La red gruesa del cuerpo. Vale para el frontend y para todo lo que no sea `/api/`, donde una
  # peticion de 20 MB ya es desproporcionada. `/api/` declara la suya, mas alta, y dice por que.
  client_max_body_size 20m;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }

  location = /api {
    return 301 /api/;
  }

  # ⛔ Las rutas internas NO salen a internet.
  #
  # `location /api/` publica el backend ENTERO —la barra final del proxy_pass quita el prefijo— asi
  # que sin esto `/api/internal/...` seria alcanzable desde fuera. Va ANTES que `/api/` porque nginx
  # elige el prefijo mas largo, y `^~` para que no lo gane una expresion regular de mas abajo.
  #
  # Es UNA de las dos capas: el backend ademas exige una clave compartida. Esta regla se comprueba
  # desde fuera con un curl; la clave protege si alguien copia mal esta configuracion en otro
  # entorno.
  location ^~ /api/internal/ {
    return 404;
  }

  location /api/ {
    # La red gruesa (ver `nginx.conf`). El limitador de verdad esta en el backend: este solo evita
    # que una inundacion llegue a convertirse en una consulta a la base por peticion.
    limit_req zone=api_general burst=60 nodelay;

    # ⛔ EL 413 DEL MULTIFIRMADOR ESTABA AQUI, Y NO ERA UN FALLO DE LA FIRMA.
    #
    # `POST /api/deasy/v1/sign/batch/start` manda **todos** los PDF del lote en un solo
    # multipart, asi que su peso es el del lote entero: 74 documentos medidos el 2026-11-10
    # pesaban 36,1 MB y el tope de aqui eran 20. nginx los rechazaba **tras leer la cabecera**
    # --1 ms, 130 KB subidos de 36 MB-- con su pagina HTML de 176 bytes; el frontend hacia
    # `response.json()` sobre ese HTML y lo que veia la persona era un error de sintaxis, no
    # «el lote pesa demasiado». Tres sintomas, una causa, y ninguno nombraba el tamaño.
    #
    # 200m NO es un numero elegido por simetria: es el tope del backend --200 documentos por
    # lote, `MAX_DOCUMENTOS_POR_LOTE` en `dominios/firmas/routes/index.js`-- por 1 MB de media,
    # que es el doble de la media medida (477 KiB). Las dos cifras tienen que moverse juntas: la
    # de aqui acota los BYTES y la del backend acota los DOCUMENTOS, y un lote legitimo tiene que
    # pasar las dos.
    #
    # ⚠️ Sigue habiendo un tope, y es a proposito: con `proxy_request_buffering` en on --el
    # defecto-- nginx escribe el cuerpo entero en su disco antes de pasarlo, asi que un cuerpo sin
    # limite es un disco sin limite. Lo que quita el tope de verdad no es subirlo otra vez: es que
    # el lote deje de viajar en UNA peticion.
    client_max_body_size 200m;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass http://${BACKEND_UPSTREAM}/;
  }

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass http://${FRONTEND_UPSTREAM};
  }
}
